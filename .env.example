# =============================================================================
# TRAK Backend — environment variables
# =============================================================================
# Copy to `.env` in this directory (never commit `.env`).
# All runtime config is loaded in TRAK_Backend/settings.py from these keys.
# Application code must use `django.conf.settings`, not os.environ directly.
# =============================================================================

# --- Django core (required) ---
DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Render sets this automatically on deploy:
# RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com

# Production HTTPS / CORS (when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
CORS_ALLOW_ALL_ORIGINS=false
# Production front-end only; DEBUG=True auto-adds http://localhost:3000 and :5173 in settings.py
CORS_ALLOWED_ORIGINS=https://your-app.example.com

# --- MongoDB (required) ---
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017
# Atlas SRV (needs DNS):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# Atlas standard (if SRV times out on campus Wi‑Fi):
# MONGODB_URI_DIRECT=mongodb://user:pass@host1:27017,host2:27017/?ssl=true&...
MONGODB_DJANGO_DATABASE=trak_django
MONGODB_RAW_DATABASE=TRAK_DB
MONGODB_RAW_COLLECTION=raw_articles
MONGODB_PROCESSED_COLLECTION=processed_articles
MONGODB_USER_KEYWORDS_COLLECTION=user_keywords
MONGODB_CHATBOT_HISTORY_COLLECTION=chatbot_history
MONGODB_NOTIFICATIONS_COLLECTION=notifications
MONGODB_DEVICE_TOKENS_COLLECTION=device_tokens
MONGODB_USER_PREFERENCES_COLLECTION=user_preferences
MONGODB_BOOKMARKS_COLLECTION=bookmarks
MONGODB_REACTIONS_COLLECTION=reactions

# --- Redis / Channels (optional locally; recommended in production) ---
USE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379/0

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Auth throttling ---
THROTTLE_REGISTER=10/hour
THROTTLE_LOGIN=30/hour
THROTTLE_REFRESH=120/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_OTP_SEND=10/hour
THROTTLE_OTP_VERIFY=30/hour
THROTTLE_EMAIL_VALIDATE=60/hour
RATELIMIT_ENABLE=true

# --- Email validation / OTP / lockout ---
EMAIL_VALIDATION_CHECK_MX=true
EMAIL_VALIDATION_BLOCK_DISPOSABLE=true
# EMAIL_VALIDATION_BLOCKED_DOMAINS=
# EMAIL_VALIDATION_DISPOSABLE_EXTRA=
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_OTP_VERIFY_MAX_ATTEMPTS=5
AUTH_OTP_VERIFY_LOCKOUT_SECONDS=900
REGISTER_SEND_VERIFICATION_OTP=true
# Return OTP in API when DEBUG=true or OTP_DEV_PREVIEW=true (dev only)
OTP_DEV_PREVIEW=false

# --- Email delivery ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=TRAK <noreply@trak.local>
EMAIL_WORKER_THREADS=4
PASSWORD_RESET_FRONTEND_URL=http://127.0.0.1:5173/reset-password
SOCIAL_AUTH_FRONTEND_URL=http://127.0.0.1:5173/login

# --- OAuth (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/social/google/callback/
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/social/github/callback/
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/api/auth/social/facebook/callback/
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/social/apple/callback/
ALLOW_DEMO_SOCIAL_LOGIN=false

# --- Admins ---
# Extra admin emails on signup (comma-separated). Built-in three admins always apply.
# ADMIN_EMAILS=
# Password for: python manage.py seed_default_admins
# SEED_ADMIN_PASSWORD=

# =============================================================================
# External APIs (keys + base URLs — set all you use; no defaults in Python code)
# =============================================================================

# --- Hugging Face (Spaces + private repos) ---
# HF_TOKEN=hf_...

# --- Summarizer (HF Space preferred) ---
SUMMARIZER_SPACE_ID=daniB2112/bart-news-summarizer
SUMMARIZER_SPACE_API_NAME=/summarize
SUMMARIZER_ENABLED=true
SUMMARIZER_MAX_INPUT_CHARS=4000
SUMMARIZER_MAX_NEW_TOKENS=128
SUMMARIZER_MODEL_ID=daniB2112/bart-news-summarizer

# --- Fake detection (HF Space) ---
FAKE_DETECTION_SPACE_ID=abd8433/fake-news-detection
FAKE_DETECTION_SPACE_API_NAME=/detect
CREDIBILITY_CONFIDENCE_THRESHOLD=0.6
# CREDIBILITY_MODEL_PATH=ml_artifacts/credibility/latest

# --- Fact checker (free providers) ---
FACT_CHECKER_ENABLED=true
FACT_CHECKER_PROVIDERS=wikipedia,wikidata,openalex
FACT_CHECKER_PROVIDER=wikipedia
FACT_CHECKER_PARALLEL=true
FACT_CHECKER_MAX_AGE_DAYS=30
FACT_CHECKER_PAGE_SIZE=5
FACT_CHECKER_LANGUAGE=en-US
FACT_CHECKER_TIMEOUT=15
OPENALEX_MAILTO=you@example.com
FACT_CHECKER_GOOGLE_URL=https://factchecktools.googleapis.com/v1alpha1/claims:search
FACT_CHECKER_WIKIPEDIA_URL=https://en.wikipedia.org/w/api.php
FACT_CHECKER_WIKIDATA_URL=https://www.wikidata.org/w/api.php
FACT_CHECKER_OPENALEX_URL=https://api.openalex.org/works
# GOOGLE_FACT_CHECK_API_KEY=

# --- Currents API (https://currentsapi.services) ---
CURRENTS_API_BASE_URL=https://api.currentsapi.services/v1
CURRENTS_API_KEY=
CURRENTS_API_LANGUAGE=en
# CURRENTS_API_COUNTRY=PK
# CURRENTS_API_SEARCH_CATEGORIES=technology,business,world,sports
CURRENTS_API_MAX_REQUESTS_PER_RUN=5
CURRENTS_API_FETCH_ARTICLE_PAGES=false

# --- NewsData.io (https://newsdata.io) ---
NEWSDATA_API_BASE_URL=https://newsdata.io/api/1
NEWSDATA_API_KEY=
NEWSDATA_API_LANGUAGE=en
NEWSDATA_API_SIZE=10
# NEWSDATA_API_COUNTRY=pk
# NEWSDATA_API_CATEGORIES=technology,business,world
NEWSDATA_API_MAX_REQUESTS_PER_RUN=3
NEWSDATA_API_FETCH_ARTICLE_PAGES=false

# --- GNews (https://gnews.io) ---
GNEWS_API_BASE_URL=https://gnews.io/api/v4
GNEWS_API_KEY=
GNEWS_API_LANGUAGE=en
GNEWS_API_MAX=10
# GNEWS_API_COUNTRY=pk
# GNEWS_API_CATEGORIES=world,technology,business
GNEWS_API_MAX_REQUESTS_PER_RUN=4
GNEWS_API_FETCH_ARTICLE_PAGES=false

# --- TRAK chatbot (Google Gemini) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHATBOT_MODEL=gemini-1.5-flash
GEMINI_CHATBOT_TIMEOUT=45
GEMINI_CHATBOT_FALLBACK_MODELS=gemini-1.5-flash,gemini-2.0-flash,gemini-1.5-flash-8b

# --- Article TTS (Hugging Face Space) ---
TTS_API_BASE_URL=https://abd8433-urdu-tts-api.hf.space
TTS_API_TIMEOUT_SEC=360
TTS_PREFER_LOCAL=
TTS_USE_EDGE=true
TTS_EDGE_RATE=+12%

# --- News pipeline ---
PIPELINE_WORKERS=3
PIPELINE_STALE_MINUTES=30
PIPELINE_AUTO_ENABLED=true
PIPELINE_AUTO_INTERVAL_SECONDS=90
PIPELINE_AUTO_BATCH_SIZE=50
PIPELINE_AUTO_MIN_PENDING=1
PIPELINE_AUTO_LOCK_TTL_SECONDS=7200
SPACY_MODEL=en_core_web_sm

# --- Scrapers ---
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 TRAK-NewsIngest/1.0
SCRAPER_DELAY_SECONDS=2.5
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_MAX_HTML_BYTES=5000000
SCRAPER_STORE_RAW_HTML=false
# SCRAPER_RSS_FEED_URLS=https://example.com/feed.xml
# SCRAPER_GENERIC_SOURCES_JSON=

# --- Firebase push (optional; in-app notifications work without) ---
# GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# =============================================================================
# ML training scripts only (scripts/train_credibility.py — not used at runtime)
# =============================================================================
# SEED=42
# CREDIBILITY_TRAIN_CSV=
# CREDIBILITY_TRAIN_PARQUET=
# CREDIBILITY_BASE_MODEL=roberta-base
# CREDIBILITY_OUT_DIR=ml_artifacts/credibility/latest
# EPOCHS=3
# BATCH=8
# LR=2e-5
