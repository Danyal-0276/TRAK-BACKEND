DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-service.onrender.com
DJANGO_SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com

# Tight CORS in production: list app origins as comma-separated values.
CORS_ALLOWED_ORIGINS=https://your-app.example.com

# SQLite is used for Django auth/admin data by default.
DJANGO_SQLITE_NAME=db.sqlite3
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/TRAK_DB?retryWrites=true&w=majority

# Required for websocket fanout on multi-instance deployments.
REDIS_URL=redis://default:password@host:6379

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
