DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-service.onrender.com
DJANGO_SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com

# Tight CORS in production: list app origins as comma-separated values.
CORS_ALLOWED_ORIGINS=https://your-app.example.com

# MongoDB — required for Django + news pipeline.
#
# Option A (Atlas SRV — needs working DNS; often fails on campus/corporate Wi‑Fi):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
#
# Option B (Atlas STANDARD — use if SRV/DNS times out; Atlas → Connect → Drivers → "Standard connection string"):
# MONGODB_URI=mongodb://username:password@cluster0-shard-00-00.xxxxx.mongodb.net:27017,cluster0-shard-00-01.xxxxx.mongodb.net:27017,cluster0-shard-00-02.xxxxx.mongodb.net:27017/?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
#
# Option C (local MongoDB on your PC):
# MONGODB_URI=mongodb://127.0.0.1:27017
#
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DJANGO_DATABASE=trak_django
MONGODB_RAW_DATABASE=TRAK_DB

# Required for websocket fanout on multi-instance deployments.
REDIS_URL=redis://default:password@host:6379

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Hugging Face token (optional — required for private Spaces)
# HF_TOKEN=hf_...

# BART summarizer — HF Space (preferred)
SUMMARIZER_SPACE_ID=daniB2112/bart-news-summarizer
SUMMARIZER_SPACE_API_NAME=/summarize
SUMMARIZER_ENABLED=true
SUMMARIZER_MAX_INPUT_CHARS=4000
SUMMARIZER_MAX_NEW_TOKENS=128
# Hub fallback when SUMMARIZER_SPACE_ID is unset:
SUMMARIZER_MODEL_ID=daniB2112/bart-news-summarizer

# Fake detection — HF Space (first pass)
FAKE_DETECTION_SPACE_ID=abd8433/fake-news-detection
FAKE_DETECTION_SPACE_API_NAME=/detect
CREDIBILITY_CONFIDENCE_THRESHOLD=0.6
# Optional local weights fallback (when Space unset):
# CREDIBILITY_MODEL_PATH=ml_artifacts/credibility/latest

# AI pipeline parallelism (CLI / cron / VPS timer — keep Admin HTTP at 1 worker)
PIPELINE_WORKERS=3
PIPELINE_STALE_MINUTES=30

# Fact checker — 3 free providers (2nd pass after fake detection Space)
FACT_CHECKER_ENABLED=true
FACT_CHECKER_PROVIDERS=wikipedia,wikidata,openalex
FACT_CHECKER_PARALLEL=true
# Optional contact for OpenAlex polite pool (free)
OPENALEX_MAILTO=you@example.com
# Optional 4th provider — Google Fact Check (needs API key)
# FACT_CHECKER_PROVIDERS=wikipedia,wikidata,openalex,google
# GOOGLE_FACT_CHECK_API_KEY=

# Currents API — global news JSON (free tier ~1000 requests/day)
# CURRENTS_API_KEY=your-key-here
# CURRENTS_API_LANGUAGE=en
# CURRENTS_API_COUNTRY=PK
# Optional extra category searches (+1 API request each per scrape run):
# CURRENTS_API_SEARCH_CATEGORIES=technology,business,world,sports
# CURRENTS_API_MAX_REQUESTS_PER_RUN=5
# CURRENTS_API_FETCH_ARTICLE_PAGES=false

# NewsData.io — global news JSON (free tier: 10 articles/request)
# NEWSDATA_API_KEY=your-key-here
# NEWSDATA_API_LANGUAGE=en
# NEWSDATA_API_SIZE=10
# Optional extra category queries (+1 API request each per scrape run):
# NEWSDATA_API_CATEGORIES=technology,business,world
# NEWSDATA_API_COUNTRY=pk
# NEWSDATA_API_MAX_REQUESTS_PER_RUN=3
# NEWSDATA_API_FETCH_ARTICLE_PAGES=false

# GNews — top headlines JSON (free tier: 10 articles/request)
# GNEWS_API_KEY=your-key-here
# GNEWS_API_LANGUAGE=en
# GNEWS_API_MAX=10
# Optional extra categories (+1 API request each): world, business, technology, sports, science, health
# GNEWS_API_CATEGORIES=world,technology,business
# GNEWS_API_COUNTRY=pk
# GNEWS_API_MAX_REQUESTS_PER_RUN=4
# GNEWS_API_FETCH_ARTICLE_PAGES=false
