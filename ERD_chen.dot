graph ERD_CHEN {
  graph [rankdir=LR, splines=true, overlap=false, nodesep=0.6, ranksep=1.0, bgcolor="white"];
  node [fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=10];

  // ===== Entities (Rectangles) =====
  User [shape=box, style="rounded", label="USER"];
  UserProfile [shape=box, style="rounded", label="USER_PROFILE"];
  UserFollow [shape=box, style="rounded", label="USER_FOLLOW"];
  UserKeyword [shape=box, style="rounded", label="USER_KEYWORD"];
  UserPreference [shape=box, style="rounded", label="USER_PREFERENCE"];
  DeviceToken [shape=box, style="rounded", label="DEVICE_TOKEN"];
  Notification [shape=box, style="rounded", label="NOTIFICATION"];
  RawArticle [shape=box, style="rounded", label="RAW_ARTICLE"];
  ProcessedArticle [shape=box, style="rounded", label="PROCESSED_ARTICLE"];
  Bookmark [shape=box, style="rounded", label="BOOKMARK"];
  Reaction [shape=box, style="rounded", label="REACTION"];

  // ===== Attributes (Ovals) =====
  // USER attributes
  u_id [shape=ellipse, label="id (PK)"];
  u_email [shape=ellipse, label="email (UQ)"];
  u_role [shape=ellipse, label="role"];
  u_active [shape=ellipse, label="is_active"];
  u_created [shape=ellipse, label="created_at"];
  User -- u_id;
  User -- u_email;
  User -- u_role;
  User -- u_active;
  User -- u_created;

  // USER_PROFILE attributes
  up_user_id [shape=ellipse, label="user_id (UQ, FK*)"];
  up_username [shape=ellipse, label="username"];
  up_phone [shape=ellipse, label="phone"];
  up_email_v [shape=ellipse, label="email_verified"];
  up_phone_v [shape=ellipse, label="phone_verified"];
  UserProfile -- up_user_id;
  UserProfile -- up_username;
  UserProfile -- up_phone;
  UserProfile -- up_email_v;
  UserProfile -- up_phone_v;

  // USER_FOLLOW attributes
  uf_follower [shape=ellipse, label="follower_user_id"];
  uf_followed [shape=ellipse, label="followed_user_id"];
  UserFollow -- uf_follower;
  UserFollow -- uf_followed;

  // USER_KEYWORD attributes
  uk_user_id [shape=ellipse, label="user_id (UQ, FK*)"];
  uk_keywords [shape=ellipse, label="keywords[]"];
  UserKeyword -- uk_user_id;
  UserKeyword -- uk_keywords;

  // USER_PREFERENCE attributes
  pref_user_id [shape=ellipse, label="user_id (UQ, FK*)"];
  pref_notif [shape=ellipse, label="notifications_enabled"];
  pref_personal [shape=ellipse, label="personalization_enabled"];
  UserPreference -- pref_user_id;
  UserPreference -- pref_notif;
  UserPreference -- pref_personal;

  // DEVICE_TOKEN attributes
  dt_user_id [shape=ellipse, label="user_id"];
  dt_token [shape=ellipse, label="token"];
  dt_platform [shape=ellipse, label="platform"];
  DeviceToken -- dt_user_id;
  DeviceToken -- dt_token;
  DeviceToken -- dt_platform;

  // NOTIFICATION attributes
  n_user_id [shape=ellipse, label="user_id"];
  n_type [shape=ellipse, label="type"];
  n_read [shape=ellipse, label="read"];
  n_created [shape=ellipse, label="created_at"];
  Notification -- n_user_id;
  Notification -- n_type;
  Notification -- n_read;
  Notification -- n_created;

  // RAW_ARTICLE attributes
  ra_url [shape=ellipse, label="canonical_url (UQ)"];
  ra_source [shape=ellipse, label="source_key"];
  ra_title [shape=ellipse, label="title"];
  ra_status [shape=ellipse, label="pipeline_status"];
  RawArticle -- ra_url;
  RawArticle -- ra_source;
  RawArticle -- ra_title;
  RawArticle -- ra_status;

  // PROCESSED_ARTICLE attributes
  pa_url [shape=ellipse, label="canonical_url (UQ)"];
  pa_label [shape=ellipse, label="credibility_label"];
  pa_topics [shape=ellipse, label="topic_keywords[]"];
  pa_processed [shape=ellipse, label="processed_at"];
  ProcessedArticle -- pa_url;
  ProcessedArticle -- pa_label;
  ProcessedArticle -- pa_topics;
  ProcessedArticle -- pa_processed;

  // BOOKMARK attributes
  b_user_id [shape=ellipse, label="user_id"];
  b_article_id [shape=ellipse, label="article_id"];
  Bookmark -- b_user_id;
  Bookmark -- b_article_id;

  // REACTION attributes
  r_user_id [shape=ellipse, label="user_id"];
  r_article_id [shape=ellipse, label="article_id"];
  r_type [shape=ellipse, label="reaction"];
  Reaction -- r_user_id;
  Reaction -- r_article_id;
  Reaction -- r_type;

  // ===== Relationships (Diamonds) =====
  has_profile [shape=diamond, label="HAS_PROFILE"];
  tracks_keywords [shape=diamond, label="TRACKS_KEYWORDS"];
  has_preferences [shape=diamond, label="HAS_PREFERENCES"];
  registers_token [shape=diamond, label="REGISTERS_TOKEN"];
  receives [shape=diamond, label="RECEIVES"];
  follows [shape=diamond, label="FOLLOWS"];
  bookmarks_rel [shape=diamond, label="BOOKMARKS"];
  reacts_rel [shape=diamond, label="REACTS_TO"];
  transformed_to [shape=diamond, label="TRANSFORMED_TO"];

  // Relationship links
  User -- has_profile [label="1"];
  has_profile -- UserProfile [label="1"];

  User -- tracks_keywords [label="1"];
  tracks_keywords -- UserKeyword [label="0..1"];

  User -- has_preferences [label="1"];
  has_preferences -- UserPreference [label="0..1"];

  User -- registers_token [label="1"];
  registers_token -- DeviceToken [label="0..N"];

  User -- receives [label="1"];
  receives -- Notification [label="0..N"];

  User -- follows [label="1 (follower)"];
  follows -- UserFollow [label="0..N"];
  UserFollow -- User [label="1 (followed)"];

  User -- bookmarks_rel [label="1"];
  bookmarks_rel -- Bookmark [label="0..N"];

  User -- reacts_rel [label="1"];
  reacts_rel -- Reaction [label="0..N"];

  RawArticle -- transformed_to [label="1"];
  transformed_to -- ProcessedArticle [label="0..1"];
}
