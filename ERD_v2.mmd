erDiagram
    ACCOUNTS_USER {
      bigint id PK
      string email UK
      string role
      bool is_active
      datetime created_at
    }

    AUTH_GROUP {
      int id PK
      string name UK
    }

    AUTH_PERMISSION {
      int id PK
      string codename
    }

    USER_PROFILES {
      objectid _id PK
      bigint user_id UK
      string username
      string phone
      bool email_verified
      bool phone_verified
    }

    USER_FOLLOWS {
      objectid _id PK
      bigint follower_user_id
      bigint followed_user_id
    }

    USER_KEYWORDS {
      objectid _id PK
      bigint user_id UK
      string[] keywords
    }

    USER_PREFERENCES {
      objectid _id PK
      bigint user_id UK
      bool notifications_enabled
      bool personalization_enabled
      bool push_enabled
      bool email_enabled
    }

    DEVICE_TOKENS {
      objectid _id PK
      bigint user_id
      string token
      string platform
    }

    NOTIFICATIONS {
      objectid _id PK
      bigint user_id
      string type
      bool read
      datetime created_at
    }

    CHATBOT_HISTORY {
      objectid _id PK
      bigint user_id UK
      object[] messages
    }

    RAW_ARTICLES {
      objectid _id PK
      string canonical_url UK
      string source_key
      string title
      string pipeline_status
    }

    PROCESSED_ARTICLES {
      objectid _id PK
      string canonical_url UK
      string credibility_label
      string[] topic_keywords
      datetime processed_at
    }

    BOOKMARKS {
      objectid _id PK
      bigint user_id
      string article_id
    }

    REACTIONS {
      objectid _id PK
      bigint user_id
      string article_id
      string reaction
    }

    ACCOUNTS_USER ||--o{ AUTH_GROUP : membership
    ACCOUNTS_USER ||--o{ AUTH_PERMISSION : grants

    ACCOUNTS_USER ||--|| USER_PROFILES : has_profile
    ACCOUNTS_USER ||--o| USER_KEYWORDS : tracks_keywords
    ACCOUNTS_USER ||--o| USER_PREFERENCES : sets_preferences
    ACCOUNTS_USER ||--o| CHATBOT_HISTORY : keeps_history
    ACCOUNTS_USER ||--o{ DEVICE_TOKENS : registers_device
    ACCOUNTS_USER ||--o{ NOTIFICATIONS : receives
    ACCOUNTS_USER ||--o{ BOOKMARKS : saves
    ACCOUNTS_USER ||--o{ REACTIONS : reacts

    ACCOUNTS_USER ||--o{ USER_FOLLOWS : follows
    ACCOUNTS_USER ||--o{ USER_FOLLOWS : followed_by

    RAW_ARTICLES ||--o| PROCESSED_ARTICLES : transformed_into
